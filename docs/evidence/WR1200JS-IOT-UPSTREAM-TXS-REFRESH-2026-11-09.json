  "mechanism_comparison": [
    {
      "file": "mt7603/beacon.c",
      "lines": "46-75",
      "finding": "Per-BSS BCN/BMC FQCR flush, BUSY polls, no beacon enqueue on failed poll. Queue flush alone not a late-TxS delivery receipt."
    },
    {
      "file": "mt7603/mac.c",
      "lines": "1013-1015,1096-1107",
      "finding": "TXD sets MT_TXD5_TX_STATUS_HOST and PID; ordinary tx_prepare uses mt76_tx_status_skb_add. Does not support an inference that upstream beacon lifecycle simply disables Host TxS."
    },
    {
      "file": "mt7603/main.c",
      "lines": "633-636",
      "finding": "mt7603_flush callback empty; not a reusable hardware/host report join mechanism."
    },
    {
      "file": "tx.c",
      "lines": "176-206",
      "finding": "Status lookup removes IDR entry; stale cleanup after DMA_DONE and software timeout marks TxS failed/done. This is software completion policy, not proof firmware cannot deliver a later report."
    }
  ],
  "revision_changed_since_prior_audit": false,
  "conclusion": "No new upstream protocol/delivery boundary established by this refresh. Vendor beacon state mutation and shared PID callback ownership cannot be replaced by mt76 software-status semantics without proof. MCU command ACK and data/beacon TxS remain separate mechanisms."
