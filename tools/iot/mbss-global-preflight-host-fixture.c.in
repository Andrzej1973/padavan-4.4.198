 wr_iot_ref_init(&r[1],&first,2);r[1].published=1;r[1].family=WR_REF_FAMILY_MBSS;
 wr_iot_ref_init(&r[2],&second,3);r[2].published=1;r[2].family=WR_REF_FAMILY_MBSS;
