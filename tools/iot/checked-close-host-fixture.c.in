@@CHECKED_CLOSE_FUNCTION@@
static void check_dequeue_timeout(void){
 RTMP_ADAPTER a={0};
 struct wr_iot_radio_ticket ticket;
 int before_pre=pre_calls,before_post=post_calls,before_free=ring_frees;
 wr_iot_radio_transition_init(&a.wr_iot_transition);
 a.wr_iot_transition.phase=WR_RADIO_READY;
 assert(wr_iot_radio_begin_stop(&a.wr_iot_transition,1,&ticket));
 a.DeQueueRunning[0]=TRUE;join_result=0;radio_result=1;
 assert(wr_iot_drv_close_checked(&a,NULL,&ticket)==NDIS_STATUS_FAILURE);
 assert(a.wr_iot_transition.shutdown_stage==3U);
 assert(pre_calls==before_pre&&post_calls==before_post&&ring_frees==before_free);
 assert(delay_calls>=1000);
 a.DeQueueRunning[0]=FALSE;
 assert(wr_iot_drv_close_checked(&a,NULL,&ticket)==NDIS_STATUS_FAILURE);
 assert(pre_calls==before_pre&&post_calls==before_post&&ring_frees==before_free);
}
int main(void){RTMP_ADAPTER a={0};struct wr_iot_radio_ticket t;wr_iot_radio_transition_init(&a.wr_iot_transition);a.wr_iot_transition.phase=WR_RADIO_READY;assert(wr_iot_radio_begin_stop(&a.wr_iot_transition,1,&t));join_result=1;assert(wr_iot_drv_close_checked(&a,NULL,&t)==1&&pre_calls==1&&post_calls==0&&a.wr_iot_transition.shutdown_stage==1);assert(ap_calls==1&&pci_calls==0);join_result=0;assert(wr_iot_drv_close_checked(&a,NULL,&t)==0&&pre_calls==1&&post_calls==1&&a.wr_iot_transition.shutdown_stage==2);assert(!(a.flags&fRTMP_ADAPTER_HALT_IN_PROGRESS));assert(wr_iot_drv_close_checked(&a,NULL,&t)==0&&pre_calls==1&&post_calls==1&&joins==2);assert(ap_calls==1&&pci_calls==1);a.wr_iot_transition.shutdown_stage=3;assert(wr_iot_drv_close_checked(&a,NULL,&t)==1&&pre_calls==1&&post_calls==1&&joins==2);wr_iot_radio_transition_init(&a.wr_iot_transition);a.wr_iot_transition.phase=WR_RADIO_READY;assert(wr_iot_radio_begin_stop(&a.wr_iot_transition,1,&t));radio_result=0;int oldpost=post_calls;int oldpci=pci_calls;assert(wr_iot_drv_close_checked(&a,NULL,&t)==1&&a.wr_iot_transition.shutdown_stage==3&&post_calls==oldpost&&pci_calls==oldpci+1);assert(wr_iot_drv_close_checked(&a,NULL,&t)==1&&post_calls==oldpost&&pci_calls==oldpci+1);radio_result=1;wr_iot_radio_transition_init(&a.wr_iot_transition);a.wr_iot_transition.phase=WR_RADIO_READY;a.wr_iot_transition.pm_suspending=1;assert(wr_iot_radio_begin_stop(&a.wr_iot_transition,1,&t));assert(wr_iot_drv_close_checked(&a,NULL,&t)==0);assert(a.flags&fRTMP_ADAPTER_HALT_IN_PROGRESS);check_dequeue_timeout();return 0;}
