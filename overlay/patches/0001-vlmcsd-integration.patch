+#if defined(APP_VLMCSD)
+int
+is_vlmcsd_run(void)
+{
+	if (check_if_file_exist("/usr/bin/vlmcsd"))
+	{
+		if (pids("vlmcsd"))
+			return 1;
+	}
+	return 0;
+}
+
+void
+stop_vlmcsd(void)
+{
+	eval("/usr/bin/vlmcsd.sh", "stop");
+}
+
+void
+start_vlmcsd(void)
+{
+	if (nvram_get_int("vlmcsd_enable") == 1)
+		eval("/usr/bin/vlmcsd.sh", "start");
+}
+
+void
+restart_vlmcsd(void)
+{
+	stop_vlmcsd();
+	start_vlmcsd();
+}
+#endif
