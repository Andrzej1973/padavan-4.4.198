# Use the compiler selected by the Padavan 4.4 build.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mipsel)
set(CMAKE_C_COMPILER "$ENV{CROSS_COMPILE}gcc")
set(CMAKE_CXX_COMPILER "$ENV{CROSS_COMPILE}g++")
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot
  OUTPUT_VARIABLE PADAVAN_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE PADAVAN_SYSROOT_RESULT)
if(NOT PADAVAN_SYSROOT_RESULT EQUAL 0 OR PADAVAN_SYSROOT STREQUAL "")
  message(FATAL_ERROR "Cannot resolve the selected MIPS compiler sysroot")
endif()
set(CMAKE_SYSROOT "${PADAVAN_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "$ENV{STAGEDIR}" "${PADAVAN_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_INSTALL_BINDIR /bin CACHE STRING "Target executables" FORCE)
set(CMAKE_INSTALL_LIBDIR /lib CACHE STRING "Target libraries" FORCE)
set(CMAKE_INSTALL_INCLUDEDIR /include CACHE STRING "Target headers" FORCE)
set(CMAKE_C_FLAGS_INIT "$ENV{CPUFLAGS} $ENV{CFLAGS}")
set(CMAKE_CXX_FLAGS_INIT "$ENV{CPUFLAGS} $ENV{CXXFLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "$ENV{LDFLAGS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "$ENV{LDFLAGS}")
