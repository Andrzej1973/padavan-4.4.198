+/*
+ * Move the WAN role to another external port at runtime.
+ *
+ * The requested port must be an external PHY, must not be a CPU port and must
+ * not be excluded by the board mapping. After the override the existing bridge
+ * and VLAN rebuild runs again, so every mask, VLAN entry, PVID and the port
+ * matrix are recomputed for the new port; the former WAN port leaves all of
+ * them, which is the isolation the reassignment requirement asks for.
+ */
+static int change_wan_port_x(u32 port_x)
+{
+	int power_changed;
+
+	if (port_x > ESW_EPHY_ID_MAX)
+		return -EINVAL;
+
+	if (port_x == WAN_PORT_CPU || port_x == LAN_PORT_CPU)
+		return -EINVAL;
+
+	if ((1u << port_x) & ESW_MASK_EXCLUDE)
+		return -EINVAL;
+
+	if (port_x == g_wan_port_x)
+		return 0;
+
+	if (atomic_read(&g_switch_inited) == 0)
+		return -EAGAIN;
+
+	/* Same power sequencing the bridge-mode change already relies on. */
+	power_changed = change_wan_lan_ports_power(0, 1);
+	if (power_changed)
+		msleep(500);
+
+	g_wan_port_x = port_x;
+	g_mask_wan_port_x = (1u << port_x);
+
+	esw_mask_bridge_isolate(g_wan_bridge_mode, g_wan_bwan_isolation);
+	esw_vlan_bridge_isolate(g_wan_bridge_mode, g_wan_bwan_isolation, 1, 1, 1);
+	esw_mac_table_clear();
+
+	if (power_changed)
+		change_wan_lan_ports_power(1, 1);
+
+	return 0;
+}
