+#ifdef MI_MINI_FACTORY_READ
+#include <linux/types.h>
+#include <linux/errno.h>
+extern int mi_mini_factory_read(loff_t offset, size_t length, unsigned char *buffer);
+
+/* Upstream RF_OFFSET is an absolute flash address for this board. */
+static int mi_mini_eeprom_read(unsigned char *buffer, unsigned long address,
+                             size_t length)
+{
+    if (address < 0x40000UL || address >= 0x50000UL)
+        return -EINVAL;
+    return mi_mini_factory_read(address - 0x40000UL, length, buffer);
+}
+#endif
